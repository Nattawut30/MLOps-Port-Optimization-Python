# Tickers to pull and optimize across (comma-separated)
TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA

# Historical data window
START_DATE=2020-01-01
END_DATE=2026-08-01

# Annualized risk-free rate, used in Sharpe ratio and Black-Litterman
RISK_FREE_RATE=0.045

# Where MLflow stores run history — a local folder, not a hosted service
MLFLOW_TRACKING_URI=sqlite:///./mlruns/mlflow.db

# Logging verbosity: DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO
